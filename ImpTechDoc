SQL Scripts 

FISMA Level scoring 

WITH 

-- Step 1: Select eligible devices  

eligible_devices AS( 

    SELECT  

        device_id, 

        fisma_id,  

        devicetype, 

        preferred_hostname, 

        preferred_ipv4, 

        os, 

        device_last_seen 

    FROM crma_hive.crma_hive_fismascorecard_input_devices 

    WHERE device_last_seen >= %(current_month_start)s    

), 

-- Step 2: Get asset managment status 

asset_management_status AS ( 

    SELECT 

        device_id, 

        fisma_id, 

        devicetype, 

        preferred_hostname, 

        preferred_ipv4, 

        os, 

        device_last_seen, 

        CASE 

            WHEN fisma_id IS NOT NULL THEN 'managed' 

            ELSE 'unauthorized' 

        END AS asset_status 

    FROM eligible_devices 

), 

-- Step 3: Apply identification rule 

asset_identification_status AS ( 

SELECT 

        *, 

        CASE 

            WHEN devicetype IS NOT NULL 

            AND preferred_ipv4 IS NOT NULL 

            AND preferred_hostname IS NOT NULL 

            AND ( 

                -- If device_type is 'server', 'workstation', or 'laptop', device_os must NOT be null 

                ( 

                    devicetype IN ('ENDPOINT - SERVER', 'ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                    AND os IS NOT NULL 

                ) 

                OR 

                ( 

                    devicetype NOT IN ('ENDPOINT - SERVER', 'ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                ) 

            ) 

            AND ( 

                -- If device_type is 'workstation' or 'laptop', hostname cannot be an IP address 

                ( 

                    devicetype IN ('ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                    AND preferred_hostname !~ '^\d{1,3}(\.\d{1,3}){3}$' 

                ) 

                OR 

                ( 

                    devicetype NOT IN ('ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                ) 

            ) 

            THEN TRUE 

            ELSE FALSE 

        END AS is_identified 

    FROM asset_management_status 

), 

-- Step 4:  Count assets by catagory 

asset_counts AS ( 

    SELECT 

        fisma_id, 

        COUNT(*) FILTER (WHERE is_identified = TRUE AND asset_status = 'managed') AS identified_and_managed_assets, 

        COUNT(*) FILTER (WHERE asset_status = 'managed') AS managed_assets, 

        COUNT(*) FILTER (WHERE asset_status = 'unauthorized') AS unauthorized_assets, 

        COUNT(*) AS total_assets 

    FROM asset_identification_status 

    GROUP BY fisma_id 

), 

-- Step 5: Score 

scores AS ( 

    SELECT 

        fisma_id, 

        identified_and_managed_assets, 

        managed_assets, 

        unauthorized_assets, 

        total_assets, 

        CASE 

            WHEN managed_assets = 0 OR total_assets = 0 THEN NULL 

            ELSE ROUND( 

                ((identified_and_managed_assets::float / managed_assets) - (unauthorized_assets::float / total_assets)) * 100 

            )::int 

        END AS hwam_score 

    FROM asset_counts 

), 

--  Step 6: Enrich with fisma details 

fisma_hwam_scores_enriched AS ( 

    SELECT  

        f.fisma_id, 

        f.fisma_name, 

        f.security_support_portfolio AS portfolio, 

        f.dhs_hva, 

        f.public_facing, 

        f.cfo_designated, 

        f.fips_199_security_categorization_overall, 

        f.active, 

        f.iscm_waiver,  

        f.fisma_reportable, 

        f.fisma_inventory_selc_status, 

        f.fisma_catagory, 

        s.identified_and_managed_assets, 

        s.managed_assets, 

        s.unauthorized_assets, 

        s.total_assets, 

        s.hwam_score     

    FROM crma_hive.crma_hive_snow_fismadetails f  

    LEFT JOIN scores s 

        ON s.fisma_id = f.fisma_id 

) 

SELECT  

    fisma_id, 

    fisma_name, 

    portfolio, 

    dhs_hva, 

    public_facing, 

    cfo_designated, 

    fips_199_security_categorization_overall, 

    active, 

    iscm_waiver,  

    fisma_reportable, 

    fisma_inventory_selc_status, 

    fisma_catagory, 

    identified_and_managed_assets, 

    managed_assets, 

    unauthorized_assets, 

    total_assets, 

    hwam_score  

FROM fisma_hwam_scores_enriched 

 

 

 

Component Level scoring 

WITH 

-- Step 1: Select eligible devices  

eligible_devices AS( 

    SELECT  

        d.device_id, 

        d.fisma_id,  

        d.devicetype, 

        d.preferred_hostname, 

        d.preferred_ipv4, 

        d.os, 

        d.device_last_seen, 

        f.fisma_reportable, 

        f.iscm_waiver, 

        f.fisma_inventory_selc_status, 

        f.fisma_catagory 

    FROM  crma_hive.crma_hive_fismascorecard_input_devices  d 

    LEFT JOIN crma_hive.crma_hive_snow_fismadetails f 

        ON d.fisma_id=f.fisma_id 

    WHERE device_last_seen >= %(current_month_start)s  

), 

eligible_fisma AS( 

    SELECT  

        * 

    FROM  eligible_devices       

    WHERE ((fisma_reportable iLike 'yes' 

        AND fisma_catagory in ('MAJ', 'GSS') 

        AND fisma_inventory_selc_status iLike 'Operational' 

        AND COALESCE(iscm_waiver, '') not ILIKE 'yes' 

        )  

        OR fisma_id is null 

    ) 

), 

-- Step 2: Get asset managment status 

asset_management_status AS ( 

    SELECT 

        *, 

        CASE 

            WHEN fisma_id IS NOT NULL THEN 'managed' 

            ELSE 'unauthorized' 

        END AS asset_status 

    FROM eligible_fisma 

), 

-- Step 3: Apply identification rule 

asset_identification_status AS ( 

SELECT 

        *, 

        CASE 

            WHEN devicetype IS NOT NULL 

            AND preferred_ipv4 IS NOT NULL 

            AND preferred_hostname IS NOT NULL 

            AND ( 

                -- If devicetype is 'server', 'workstation', or 'laptop', device os must NOT be null 

                ( 

                    devicetype IN ('ENDPOINT - SERVER', 'ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                    AND os IS NOT NULL 

                ) 

                OR 

                ( 

                    devicetype NOT IN ('ENDPOINT - SERVER', 'ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                ) 

            ) 

            AND ( 

                -- If devicetype is 'workstation' or 'laptop', hostname cannot be an IP address 

                ( 

                    devicetype IN ('ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                    AND preferred_hostname !~ '^\d{1,3}(\.\d{1,3}){3}$' 

                ) 

                OR 

                ( 

                    devicetype NOT IN ('ENDPOINT - WORKSTATION', 'ENDPOINT - LAPTOP') 

                ) 

            ) 

            THEN TRUE 

            ELSE FALSE 

        END AS is_identified 

    FROM asset_management_status 

), 

-- Step 4:  Count assets by catagory 

component_asset_counts AS ( 

    SELECT 

        'ICE' AS component, 

        COUNT(*) FILTER (WHERE is_identified = TRUE AND asset_status = 'managed') AS identified_and_managed_assets, 

        COUNT(*) FILTER (WHERE asset_status = 'managed') AS managed_assets, 

        COUNT(*) FILTER (WHERE asset_status = 'unauthorized') AS unauthorized_assets, 

        (SELECT COUNT(*) FROM eligible_devices) AS total_assets  

    FROM asset_identification_status 

), 

componenet_hwan_score AS ( 

    SELECT 

        component, 

        identified_and_managed_assets, 

        managed_assets, 

        unauthorized_assets, 

        total_assets, 

        CASE 

            WHEN managed_assets = 0 OR total_assets = 0 THEN NULL 

            ELSE ROUND( 

                ((identified_and_managed_assets::float / managed_assets) - (unauthorized_assets::float / total_assets)) * 100 

            )::int 

        END AS hwam_score 

    FROM component_asset_counts 

) 

SELECT  

    component, 

    identified_and_managed_assets, 

    managed_assets, 

    unauthorized_assets, 

    total_assets, 

    hwam_score 

FROM componenet_hwan_score 

 

 

 

Host-Based Defense (HBD) 

Requirements & Solution Design 

See: fisma_scorecard_hbd_score_solutions.docx 

 

Implementation 

Device Level HBD Score 

Step 0: Input Datasets 

crma_hive.crma_hive_fismascorecard_input_devices: Device inventory for FISMA Scorecard (primarily from Axonius, with adapter and EDR info). 

crma_hive.crma_hive_snow_fismadetails: FISMA system attributes and context. 

 

Step 1: Select Eligible Devices 

Purpose: Identify devices relevant for HBD scoring. 

Action: 

Select devices seen in the current month. 

Filter for devices with role 'ENDPOINT'. 

 

Step 2: Flag CrowdStrike Adapter Association 

Purpose: Determine if device is associated with CrowdStrike adapter. 

Action: 

Set flag if 'crowd_strike_adapter' is present in device's adapter list. 

 

Step 3: Add EDR and AV Compliance Fields 

Purpose: Determine device compliance with EDR and AV requirements. 

Action: 

AV compliance: Flag as compliant if CrowdStrike was seen in the last 15 days. 

EDR (Endpoint Detection and Response (intrusion prevention) ) compliance: Flag as compliant if EDR is enabled. 

 

Step 4: Calculate Device HBD Score 

Purpose: Assign HBD score to each device based on compliance posture. 

Action: 

If device is not associated with CrowdStrike adapter, assign score 0. 

Otherwise, calculate score as: ((0.5 * AV compliance) + (0.5 * EDR compliance)) * 100 

Step 5: Enrich with FISMA Details 

Purpose: Add FISMA system context to each device’s HBD score. 

Action: 

Join device scores with FISMA system details. 

Step 6: Final Output 

Purpose: Produce a comprehensive, enriched device-level HBD score report. 

Action: 

Select and present enriched device-level HBD scores and relevant FISMA attributes. 

Output Table: 
crma_hive.crma_hive_fismascorecard_device_hbd_score 

Updated daily 

Daily scores are appended to the table with ETL dates 

 

FISMA SYSTEM Level HBD Score 

Step 0: Input Datasets 

crma_hive.crma_hive_fismascorecard_device_hbd_score: Device-level HBD scores. 

crma_hive.crma_hive_snow_fismadetails: FISMA system attributes. 

 

Step 1: Calculate FISMA-Level HBD Score 

Purpose: Compute the average HBD score for each FISMA system. 

Action: 

Aggregate device-level HBD scores by FISMA ID. 

Calculate the average HBD score for each FISMA system (rounded to nearest integer). 

 

Step 2: Enrich FISMA HBD Scores with System Details 

Purpose: Add FISMA system context to each HBD score for reporting. 

Action: 

Join FISMA HBD scores with FISMA system details. 

Select relevant FISMA attributes for the final output. 

Output Table: 
crma_hive.crma_hive_fismascorecard_fisma_system_hbd_score 

Updated daily 

Daily scores are appended to the table with ETL dates 

 

SQL Scripts 

Device Level scoring 

WITH  

-- Step 1: Select eligible devices 

eligible_devices AS ( 

    SELECT  

        device_id, 

        preferred_hostname AS hostname,  

        preferred_ipv4  AS ip, 

        fisma_id, 

        adapters, 

        device_last_seen, 

        devicerole, 

        crowd_strike_last_seen, 

        edr_enabled 

    FROM  crma_hive.crma_hive_fismascorecard_input_devices 

    WHERE device_last_seen >= %(current_month_start)s 

        AND devicerole = 'ENDPOINT' 

), 

-- Step 2: Add a flag to indicate if a device is associated with CrowdStrike adapter or not 

device_crowd_strike_adapter_association AS( 

    SELECT 

        device_id, 

        hostname,  

        ip, 

        fisma_id, 

        adapters, 

        device_last_seen, 

        crowd_strike_last_seen, 

        edr_enabled, 

        ARRAY_POSITION(adapters, 'crowd_strike_adapter') IS NOT NULL AS crowd_strike_adapter 

    FROM eligible_devices 

), 

-- Step 3: Add EDR and AV compliance field 

device_edr_and_av_compliance AS ( 

    SELECT 

        device_id, 

        hostname,  

        ip, 

        fisma_id, 

        adapters, 

        device_last_seen, 

        crowd_strike_last_seen, 

        edr_enabled, 

        crowd_strike_adapter, 

        CASE  

            WHEN crowd_strike_last_seen >= current_date - INTERVAL '15' DAY THEN 1 

            ELSE 0 

        END AS av_compliance, 

        CASE  

            WHEN edr_enabled IS True THEN 1 

            ELSE 0 

        END AS edr_compliance 

    FROM device_crowd_strike_adapter_association 

), 

-- Step 4: Score 

device_hbd_score AS( 

    SELECT 

        device_id, 

        hostname,  

        ip, 

        fisma_id, 

        device_last_seen, 

        adapters, 

        crowd_strike_last_seen, 

        edr_enabled, 

        crowd_strike_adapter, 

        av_compliance, 

        edr_compliance, 

        CASE 

            WHEN crowd_strike_adapter IS NOT TRUE THEN 0 

            ELSE ROUND(((0.5 * av_compliance) + (0.5 * edr_compliance)) * 100)::int 

        END AS hbd_score 

    FROM device_edr_and_av_compliance 

), 

-- Step 5: Enrich with FISMA system information 

device_hbd_scores_enriched AS ( 

    SELECT  

        dhs.device_id, 

        dhs.hostname,  

        dhs.ip, 

        dhs.fisma_id, 

        fd.fisma_name, 

        fd.security_support_portfolio AS portfolio, 

        fd.dhs_hva, 

        fd.public_facing, 

        fd.cfo_designated, 

        fd.fips_199_security_categorization_overall, 

        fd.active, 

        fd.iscm_waiver,  

        fd.fisma_reportable, 

        fd.fisma_inventory_selc_status, 

        fd.fisma_catagory, 

        dhs.adapters, 

        dhs.device_last_seen, 

        dhs.crowd_strike_last_seen, 

        dhs.edr_enabled, 

        dhs.crowd_strike_adapter, 

        dhs.av_compliance, 

        dhs.edr_compliance, 

        dhs.hbd_score         

    FROM device_hbd_score dhs 

    LEFT JOIN crma_hive.crma_hive_snow_fismadetails fd 

        ON dhs.fisma_id = fd.fisma_id 

) 

SELECT  

    device_id, 

    hostname,  

    ip, 

    fisma_id, 

    fisma_name, 

    portfolio, 

    dhs_hva, 

    public_facing, 

    cfo_designated, 

    fips_199_security_categorization_overall, 

    active, 

    iscm_waiver,  

    fisma_reportable, 

    fisma_inventory_selc_status, 

    fisma_catagory, 

    adapters, 

    device_last_seen, 

    crowd_strike_last_seen, 

    edr_enabled, 

    crowd_strike_adapter, 

    av_compliance, 

    edr_compliance, 

    hbd_score         

FROM device_hbd_scores_enriched 

 

FISMA Level scoring 

